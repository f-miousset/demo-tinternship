# The frontend is a static Vite build. It never learns the backend's address:
# every call in lib/api.ts is origin-relative, and Traefik routes /api to the
# API container ahead of this one. That is the same arrangement the Vite dev
# proxy creates locally, so dev and production agree about where /api lives.

FROM node:24-alpine AS build
WORKDIR /src

# npm ci from the lockfile alone, before the sources, so a change to a component
# does not reinstall the tree.
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.31-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO /dev/null http://127.0.0.1/index.html || exit 1
