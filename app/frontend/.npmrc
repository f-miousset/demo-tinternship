# npm 12 made `allow-remote=none` the default, and it mis-fires on the registry
# itself: resolving a package that declares bundleDependencies fetches that
# package's registry.npmjs.org tarball through a path that skips npm's
# "same host as the registry" exemption, so `npm install` refuses it with
# EALLOWREMOTE. Here that is @tailwindcss/oxide-wasm32-wasi, and the install that
# hits it is Renovate's weekly lockFileMaintenance, which regenerates
# package-lock.json from scratch (PR #19, 2026-09-27). `all` is npm 11's default,
# so this restores what every earlier lockfile was built under; the lockfile's
# integrity hashes still pin every tarball.
# REMOVE when npm/cli#9800 is fixed — see documentation/testing.md.
allow-remote=all
