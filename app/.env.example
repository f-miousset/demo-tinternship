# ---------------------------------------------------------------------------
# Tinternship — environment
# Copy to .env and fill in. Only GOOGLE_API_KEY is required to run.
# ---------------------------------------------------------------------------

# --- Gemini (required) ---------------------------------------------------
# Either an AI Studio key (https://aistudio.google.com/apikey) with the line
# below FALSE, or a Google Cloud "Agent Platform" (Vertex AI) API key with it
# TRUE. Vertex bills the Cloud billing account, so Cloud credits pay for it;
# AI Studio is prepaid for accounts opened after March 2026 and they do not.
# See documentation/models.md#ai-studio-or-vertex-ai.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Models --------------------------------------------------------------
# All three are edited from the Settings page, which stores them in the
# database. They are commented out here on purpose: an uncommented line only
# sets the *starting* value for a deployment that has never saved one, and a
# stored value silently wins over it forever after. Leave them commented unless
# you are bootstrapping a machine that has to boot on something other than the
# default below — a host with no Google key that must come up on Ollama, say.
# See documentation/configuration.md#env-is-a-bootstrap-not-the-live-value.
#
# All three accept a Gemini id; the first two also accept `ollama/<name>` to run
# on the local Ollama.
#
# Workhorse model for reasoning agents.        (default: gemini-3.6-flash)
#MODEL_PRIMARY=gemini-3.6-flash
# Cheap model for critics, extraction and normalisation.
#                                              (default: gemini-3.5-flash-lite)
#MODEL_FAST=gemini-3.5-flash-lite
# The Scout and the HR researcher, which carry Google Search. Gemini only:
# grounding is part of the Gemini API and has no local equivalent.
#                                              (default: gemini-3.6-flash)
#MODEL_GROUNDED=gemini-3.6-flash

# --- Ollama (optional) ---------------------------------------------------
# Only used when a model above is `ollama/…`. From a container this has to be
# host.docker.internal — localhost inside the container is the container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=600

# --- Quality gate --------------------------------------------------------
# Both are edited from the Settings page and commented out for the same reason
# as the models above: this file sets a starting value, not the live one.
#
# Generative artifacts below this overall rubric score (0-10) get one
# automatic revision pass.                                     (default: 7.5)
#AUDIT_PASS_THRESHOLD=7.5
# How many rewrites a document gets trying to clear it.           (default: 2)
#AUDIT_MAX_REVISIONS=2

# --- Follow-ups ----------------------------------------------------------
# Days of silence on an application you are waiting on before the Tracker
# raises it and the chase email is drafted for you. Edited from the Settings
# page and commented out for the same reason as the models above: this file
# sets a starting value, not the live one.                       (default: 14)
#FOLLOW_UP_AFTER_DAYS=14
# How often the background sweep looks for applications that have newly gone
# quiet. It only spends a model call on one that has, so this is latency, not
# cost. Not a runtime knob — a restart is fine for it.            (default: 6)
FOLLOW_UP_SWEEP_HOURS=6

# --- Priority job platforms ----------------------------------------------
# Boards the Scout searches before anything general, in this order. These need
# no credentials — they are reached with site: queries through grounded search.
# Known keys: welcome_to_the_jungle, linkedin, station_f
# Drop station_f (Paris-only) and reorder for a search outside France; leave
# empty to search the open web with no priority pass.
PRIORITY_JOB_PLATFORMS=welcome_to_the_jungle,linkedin,station_f

# How many ranked postings one Investigator run returns. This is only where the
# slider on the Jobs page starts — each run can ask for a different number.
# More results means more searches, so a bigger run costs more and takes longer.
RESULTS_PER_RUN=15

# --- Recency -------------------------------------------------------------
# An internship posting is perishable: the role fills, the cohort closes, and
# the page never says so. Age is therefore weighted heavily in the ranking.
#
# How many days it takes a posting to be worth half as much as an identical one
# published today — a quarter after twice as many, down to a floor so a great
# old posting still beats a poor fresh one. Lower pushes this week's openings up
# harder.
#
# Edited from the Settings page; commented out because this file sets a starting
# value, not the live one.                                        (default: 21)
#POSTING_HALF_LIFE_DAYS=21
# The window a structured job board (Adzuna) is asked for at all. Grounded
# search has no equivalent filter, so this bounds that one source only.
POSTING_MAX_AGE_DAYS=45

# --- Adzuna job source (optional) ---------------------------------------
# Free tier ~1000 calls/month, covers France + 15 other countries.
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Default country code for Adzuna queries (fr, gb, us, de, it, ...).
ADZUNA_COUNTRY=fr

# --- Server --------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
LOG_LEVEL=INFO
